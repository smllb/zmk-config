#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ----------------------------------------------------------------------------
// Layer 0: alpha (top to bottom)
//   col 0 (lone)  col 1    col 2    col 3    col 4    col 5    col 6
//   -----------   -----    -----    -----    -----    -----    -----
// ROW 1 (top):               N7       N8       N9       N0       MINUS    BSPC
// ROW 2:                     Y        U        I        O        P        RET
// ROW 3 (mid):    ESC        H        N        M        L        SEMI     SQT
// ROW 4:                     J        K        COMMA    DOT      FSLH     SPC
// ROW 5 (bot):               N1       N2       N3       N4       N5       N6
// ----------------------------------------------------------------------------
            bindings = <
    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp BSPC
    &kp Y     &kp U     &kp I     &kp O     &kp P     &kp RET
    &kp ESC   &kp H     &kp N     &kp M     &kp L     &kp SEMI  &kp SQT
    &kp J     &kp K     &kp COMMA  &kp DOT   &kp FSLH  &kp SPC
    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
            >;
        };

        nav_layer {
// ----------------------------------------------------------------------------
// Layer 1: nav (top to bottom)
// ----------------------------------------------------------------------------
            bindings = <
    &kp F7    &kp F8   &kp F9   &kp F10  &kp F11   &kp F12
    &kp HOME  &kp PG_DN &kp PG_UP &kp END &trans    &trans
    &trans    &kp LEFT &kp DOWN &kp UP   &kp RIGHT &trans   &trans
    &bt BT_CLR &trans  &trans   &trans   &trans    &trans
    &trans    &trans   &trans   &trans   &to 0      &trans
            >;
        };

    };
};
