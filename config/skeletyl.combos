/*
 * ZMK Combos for skeletyl
 *
 * Combo summary:
 * D+K = One-shot Navigation layer (from default)
 * E+I = One-shot Number layer (from default)
 * C+COMMA = One-shot Symbol layer (from default)
 * Q+P = ~
 * Z+SLSH = Ctrl+Alt+L
 * G+H = Ctrl+Alt+T
 * A+QUOT = Shift x2
 * B+N = Toggle Bluetooth Layer
 * M+K = Switch between Default & Navigation layers
 * LEFT+UP = Go to Default Layer
 * LEFT+UP+RIGHT = Go to Default Layer
 * RIGHT+UP = Go to Default Layer
 * S+D+F = Go to Gaming Layer (Overwatch)
 * G+B = Toggle Gaming Layer (Overwatch)
 * J+K (16+17) = Toggle Symbol Layer from Default / Go back to Default from Symbol Layer
 * D+F (12+13) = Toggle Symbol Layer from Default / Go back to Default from Symbol Layer
 * M+K (26+17) = Toggle Navigation Layer from Default / Go back to Default from Navigation Layer
 * M+COMMA (26+27) = Toggle Function Layer from Default / Go back to Default from Function Layer
 */

// Layer definitions - copied from skeletyl.keymap for consistency
#define DEFAULT 0
#define SYMBOL 1
#define NAVIGATION 2
#define NUMBER 3
#define FUNCTION 4
#define MEDIA 5
#define GAMING 6
#define BT 7
#define TAB_LAYER 8
#define BATTLEFIELD 9

/ {
    combos {
        compatible = "zmk,combos";

        combo_screenshot {
            timeout-ms = <25>;
            key-positions = <30 31>;
            bindings = <&kp PSCRN>;
            layers = <DEFAULT SYMBOL NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        // === Toggle Layer Combos (25ms timeout) ===
        // --- Layer Toggle Combos (left: 1,2 11,12 21,22; right: 7,8 17,18 27,28) --- 

        combo_to_nav_16_7_8{
            timeout-ms = <25>;
            key-positions = <19 8 9>;
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT NUMBER SYMBOL MEDIA BT GAMING>;
        };
        combo_to_nav_16_7{
            timeout-ms = <25>;
            key-positions = <19 8>;
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT NUMBER SYMBOL MEDIA BT GAMING>;
        };
        combo_to_nav_7_8{
            timeout-ms = <25>;
            key-positions = <8 9>;
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT NUMBER SYMBOL MEDIA BT GAMING>;
        };

        combo_to_nav_7_8_to_default{
            timeout-ms = <25>;
            key-positions = <8 9>;
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>;
        };
        combo_to_nav_16_7_8_to_default{
            timeout-ms = <25>;
            key-positions = <19 8 9>;
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>;
        };
        combo_to_nav_16_7_to_default{
            timeout-ms = <25>;
            key-positions = <19 8>;
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>;
        };

        

        // Go to BT layer with 30 + 35 (all except BT)
        combo_to_bt_3035 {
            timeout-ms = <30>;
            key-positions = <36 41>; // 30 + 35
            bindings = <&to BT>; // Go to BT layer
            layers = <DEFAULT SYMBOL NAVIGATION NUMBER FUNCTION MEDIA GAMING>; // All except BT
        };

        // On BT: 30 + 35 returns to DEFAULT
        combo_bt_3035_to_default {
            timeout-ms = <30>;
            key-positions = <36 41>; // 30 + 35
            bindings = <&to DEFAULT>;
            layers = <BT>;
        };
      
        combo_to_bt_429 {
            timeout-ms = <30>;
            key-positions = <5 34>; 
            bindings = <&to BT>; // Go to BT layer
            layers = <DEFAULT SYMBOL NAVIGATION NUMBER FUNCTION MEDIA GAMING>; // All except BT
        };
     
        combo_bt_429_to_default {
            timeout-ms = <30>;
            key-positions = <5 34>; 
            bindings = <&to DEFAULT>;
            layers = <BT>;
        };
        // On BT: 20 + 32 + 33 + 29 sends BT_CLR_ALL
        combo_bt_clr_all_20_32_33_29 {
            timeout-ms = <30>;
            key-positions = <25 38 39 34>; // 20 + 32 + 33 + 29
            bindings = <&bt BT_CLR_ALL>;
            layers = <BT>;
        };


        combo_gui_fk {
            timeout-ms = <50>;
            key-positions = <16 19>; // F + K
            bindings = <&kp LGUI>;
        };
        
        combo_double_shift_a_apos {
            timeout-ms = <50>;
            key-positions = <13 22>; // A + APOS working 
            bindings = <&double_lshift>;
        };
        
        combo_lock_session_z_slash {
            timeout-ms = <20>;
            key-positions = <25 34>; // Z + SLASH working 
            bindings = <&lock_session>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp ESC>; // working
        }; 
        
        combo_alt_f4 {
            timeout-ms = <50>;
            key-positions = <2 20>;     // W + K keys
            bindings = <&alt_f4>;      // Trigger the Alt+F4 macro
            layers = <DEFAULT>;        // Only active on default layer working
        };
        
        combo_terminal_gh {
            timeout-ms = <50>;
            key-positions = <17 18>;   // G + H
            bindings = <&kp LC(LA(T))>; // Ctrl+Alt+T
            layers = <DEFAULT>;        // Only active on default layer not working 
        };

    };
};
