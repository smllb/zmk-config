#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define ALPHA 0
#define SYM 1
#define NAV 2

/ {
    behaviors {
        // Hold -> Key Press (Modifier), Tap -> Toggle Layer
        // Usage: &mtt LSHIFT 1 (Hold Shift, Tap Toggle Layer 1)

        mtt: mod_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_TOGGLE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alpha {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp EQUAL  &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp RET  &mtt LSHFT 1  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mtt RSHFT NAV  &kp LCTRL  &kp LALT  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp RCTRL
            >;
        };

        sym {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp TILDE  &kp EXCL  &lt ALPHA AT  &kp DLLR  &kp AMPS  &kp RBKT  &kp COLON  &lt ALPHA SEMI  &kp MINUS  &kp EQUAL  &trans  &trans  &kp HASH  &kp CARET  &kp PRCNT  &kp ASTRK  &trans  &kp LBKT  &kp LPAR  &kp RPAR  &kp UNDER  &kp PLUS  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp BSLH  &kp LBRC  &kp RBRC  &kp PIPE  &trans  &trans  &tog 1  &tog 1  &trans  &trans  &tog 1  &tog 1  &tog 1  &to 0
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp UP  &kp END  &kp PG_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &trans  &trans  &trans  &trans  &to 0  &kp DEL  &trans  &trans
            >;
        };
    };
};
